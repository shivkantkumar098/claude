
{
  "mcpServers": {
    "atlassian": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "mcp-atlassian"
      ],
      "env": {
         "JIRA_URL": "https://shivkantkr.atlassian.net/",
        "JIRA_USERNAME": "shivkantkr9934@gmail.com",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
          
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    }
  }
}
