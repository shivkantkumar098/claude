# Copy this file to .env (git-ignored) and fill in real values. NEVER commit .env.
# Claude Code expands ${VAR} in .mcp.json from your shell environment, so load these before starting it:
#   PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process') } }
#   Git Bash:    set -a; source .env; set +a
JIRA_USERNAME=
JIRA_API_TOKEN=
GITHUB_PAT=
